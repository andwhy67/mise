    {
      "id": 5,
      "title": "Расход по часам (топ-8 продуктов)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "Чистое списание под заказы (минус возвраты при отмене), в базовых единицах.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "WITH top AS (\n            SELECT product_id FROM consumption_hourly WHERE $__timeFilter(hour_bucket)\n            GROUP BY product_id ORDER BY sum(qty_consumed) DESC LIMIT 8)\n        SELECT c.hour_bucket AS time, p.name AS metric, c.qty_consumed AS value\n        FROM consumption_hourly c JOIN top USING (product_id) JOIN products p ON p.id = c.product_id\n        WHERE $__timeFilter(c.hour_bucket)\n        ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Заказы по часам",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
