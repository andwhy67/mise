      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(i.price_snapshot * i.quantity), 0) AS \"Выручка\"\n        FROM orders o JOIN order_items i ON i.order_id = o.id\n        WHERE o.status <> 'Cancelled' AND $__timeFilter(o.created_at)"
        }
      ],
