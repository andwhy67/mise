            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, count(*) AS \"Заказов\"\n        FROM orders WHERE status <> 'Cancelled' AND $__timeFilter(created_at)\n        GROUP BY 1 ORDER BY 1"
        }
