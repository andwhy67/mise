    {
      "id": 7,
      "title": "Дефицитные ингредиенты",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.name AS \"Продукт\",\n               count(*) FILTER (WHERE e.started_at >= $__timeFrom()) AS \"Уходов в стоп\",\n               count(DISTINCT e.dish_id) AS \"Блюд\",\n               round(sum(extract(epoch FROM least(coalesce(e.ended_at, now()), $__timeTo()) - greatest(e.started_at, $__timeFrom()))) / 60) AS \"Минут блюд в стопе\"\n        FROM stoplist_history e JOIN products p ON p.id = e.limiting_product_id\n        WHERE e.started_at < $__timeTo() AND (e.ended_at IS NULL OR e.ended_at > $__timeFrom())\n        GROUP BY p.name ORDER BY \"Минут блюд в стопе\" DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Доля списаний от поступившего",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.name AS \"Продукт\", p.unit AS \"Ед.\",\n               sum(m.qty_delta) FILTER (WHERE m.type = 'Receipt') AS \"Поступило\",\n               -coalesce(sum(m.qty_delta) FILTER (WHERE m.type IN ('ExpiryWriteOff', 'ManualWriteOff')), 0) AS \"Списано\",\n               round(100 * -coalesce(sum(m.qty_delta) FILTER (WHERE m.type IN ('ExpiryWriteOff', 'ManualWriteOff')), 0)\n                     / nullif(sum(m.qty_delta) FILTER (WHERE m.type = 'Receipt'), 0), 1) AS \"Списано, %\"\n        FROM stock_movements m JOIN products p ON p.id = m.product_id\n        WHERE $__timeFilter(m.created_at)\n        GROUP BY p.name, p.unit\n        HAVING sum(m.qty_delta) FILTER (WHERE m.type = 'Receipt') > 0\n        ORDER BY \"Списано, %\" DESC NULLS LAST LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
