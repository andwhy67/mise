    {
      "id": 5,
      "title": "Скоро истекает (пригодные партии, 48 ч)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.name AS \"Продукт\", b.remaining_qty AS \"Остаток\", p.unit AS \"Ед.\",\n               b.expires_at AS \"Истекает\", round(extract(epoch FROM b.expires_at - now()) / 3600, 1) AS \"Часов\"\n        FROM batches b JOIN products p ON p.id = b.product_id\n        WHERE b.status = 'Active' AND b.remaining_qty > 0 AND b.expires_at > now() AND b.expires_at <= now() + interval '48 hours'\n        ORDER BY b.expires_at LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Пригодный остаток и минимум",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT name AS \"Продукт\", unit AS \"Ед.\", usable AS \"Доступно\", min_stock_qty AS \"Минимум\"\n        FROM (\n            SELECT p.name, p.unit, p.min_stock_qty,\n                   coalesce(sum(b.remaining_qty) FILTER (WHERE b.status = 'Active' AND b.expires_at > now()), 0) AS usable\n            FROM products p LEFT JOIN batches b ON b.product_id = p.id\n            GROUP BY p.id, p.name, p.unit, p.min_stock_qty\n        ) s\n        ORDER BY (usable < min_stock_qty) DESC, name"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Списания по дням",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', created_at) AS time,\n               CASE type WHEN 'ExpiryWriteOff' THEN 'По сроку' ELSE 'Вручную' END AS metric,\n               count(*) AS value\n        FROM stock_movements\n        WHERE type IN ('ExpiryWriteOff', 'ManualWriteOff') AND $__timeFilter(created_at)\n        GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Блюд в стоп-листе во времени",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT t AS time, count(e.id) AS \"Блюд в стопе\"\n        FROM generate_series(date_trunc('hour', $__timeFrom()::timestamptz), $__timeTo()::timestamptz, interval '1 hour') AS t\n        LEFT JOIN stoplist_history e ON e.started_at <= t AND (e.ended_at IS NULL OR e.ended_at > t)\n        GROUP BY t ORDER BY t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
