          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Операций\" FROM stock_movements\n        WHERE type IN ('ExpiryWriteOff', 'ManualWriteOff') AND $__timeFilter(created_at)"
        }
