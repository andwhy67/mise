            "uid": "mise-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Партий\" FROM batches\n        WHERE status = 'Active' AND remaining_qty > 0 AND expires_at > now() AND expires_at <= now() + interval '24 hours'"
