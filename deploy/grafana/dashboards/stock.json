    {
      "id": 4,
      "title": "Списаний за период",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mise-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 18,
