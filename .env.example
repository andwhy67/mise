# Скопируйте в .env и при необходимости поменяйте. Реальные секреты в репозиторий не коммитим.

# PostgreSQL
POSTGRES_DB=mise
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise_dev_password
POSTGRES_PORT=5432

# Redis
# Хост-порт Redis (6380, чтобы не конфликтовать с локальным Redis на 6379)
REDIS_PORT=6380

# API
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Production
# Swagger UI (/swagger). В prod — false; для демо экспертам можно оставить true
SWAGGER_ENABLED=true
# Стартовый словарь продуктов и блюд (идемпотентно, существующие записи не трогает)
SEED_ENABLED=true
# Через запятую: источники, которым разрешён CORS (фронт в dev и в compose)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Безопасность (в prod — обязательно свои значения; ключ: openssl rand -base64 48)
AUTH_SIGNING_KEY=dev-only-signing-key-not-for-production-0123456789
# Пароль демо-учёток manager / chef / warehouse и служебной simulator
DEMO_PASSWORD=mise-demo
SIMULATOR_PASSWORD=mise-simulator
# Cookie с refresh-токеном только по https (true в prod за TLS)
AUTH_COOKIE_SECURE=false
# Доверять X-Forwarded-For/Proto (API доступен только через nginx/прокси платформы)
TRUST_PROXY_HEADERS=true
# Роль БД только на чтение — для Grafana
DB_READONLY_USER=mise_readonly
DB_READONLY_PASSWORD=mise_readonly_dev

# Мониторинг сроков: период тика (с) и автосписание просроченных партий
EXPIRY_ENABLED=true
EXPIRY_INTERVAL_SECONDS=30
EXPIRY_AUTO_WRITE_OFF=true
# POST /api/v1/demo/seed-stock — демо-наполнение склада (на публичном проде можно выключить)
DEMO_ENABLED=true

# Симулятор: стартует остановленным, управление — POST /api/v1/simulator/start|stop|scenario|speed
SIMULATOR_AUTOSTART=false

# Grafana (дашборды «Склад и сроки», «Расход и дефицит»); анонимный просмотр — для демо
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
# Просмотр дашбордов без входа. В prod — false; для демо можно true
GRAFANA_ANONYMOUS=true

# Web (nginx)
WEB_PORT=8081

# --- Пуши на телефон (Web Push) ---
# Закрытый ключ VAPID: dotnet run --project src/Mise.Api -- --generate-vapid-keys
# Пусто в prod — пуши выключены. Dev-стек (docker-compose.yml) использует свой dev-ключ, если здесь пусто.
# Ключ менять нельзя без нужды: старые подписки браузеров перестанут работать.
PUSH_PRIVATE_KEY=
# Контакт для сервисов пушей (RFC 8292): mailto: или https:
PUSH_SUBJECT=mailto:admin@mise.local

# Входов в минуту с одного IP. Для e2e (npm run e2e) временно поднимите, например до 300.
LOGIN_PER_MINUTE=10
