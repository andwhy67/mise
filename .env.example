# Скопируйте в .env и при необходимости поменяйте. Реальные секреты в репозиторий не коммитим.

# PostgreSQL
POSTGRES_DB=mise
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise_dev_password
POSTGRES_PORT=5432

# Redis
# Хост-порт Redis (6380, чтобы не конфликтовать с локальным Redis на 6379)
REDIS_PORT=6380

# API
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Production
SWAGGER_ENABLED=true
# Стартовый словарь продуктов и блюд (идемпотентно, существующие записи не трогает)
SEED_ENABLED=true
# Через запятую: источники, которым разрешён CORS (фронт в dev и в compose)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Мониторинг сроков: период тика (с) и автосписание просроченных партий
EXPIRY_ENABLED=true
EXPIRY_INTERVAL_SECONDS=30
EXPIRY_AUTO_WRITE_OFF=true
# POST /api/v1/demo/seed-stock — демо-наполнение склада (на публичном проде можно выключить)
DEMO_ENABLED=true

# Симулятор: стартует остановленным, управление — POST /api/v1/simulator/start|stop|scenario|speed
SIMULATOR_AUTOSTART=false

# Grafana (дашборды «Склад и сроки», «Расход и дефицит»); анонимный просмотр — для демо
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ANONYMOUS=true

# Web (nginx)
WEB_PORT=8081
