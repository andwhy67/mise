{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "ReadOnlyUser": "",
    "ReadOnlyPassword": ""
  },
  "Swagger": {
    "Enabled": false
  },
  "Seed": {
    "Enabled": false
  },
  "Realtime": {
    "DebounceMilliseconds": 250
  },
  "Demo": {
    "Enabled": false
  },
  "HotOffers": {
    "Scorer": "v2",
    "RefreshSeconds": 60,
    "MaxHorizonHours": 72,
    "HorizonShelfFraction": 0.5,
    "VolumeBaseWeight": 0.5,
    "ShareBaseWeight": 0.6,
    "SecondaryBonus": 0.25,
    "SellThroughFloor": 0.5,
    "FullCapacityPortions": 3,
    "EnterThreshold": 15,
    "ExitThreshold": 10,
    "TopN": 5
  },
  "Forecast": {
    "HistoryDays": 7,
    "FlatAlpha": 0.08,
    "ProfileAlpha": 0.5,
    "ProfileMinDays": 3,
    "StepMinutes": 15,
    "StopListHorizonHours": 24,
    "MaxStopListHorizonHours": 72,
    "SupplyHorizonHours": 72,
    "MaxSupplyHorizonHours": 336,
    "SafetyHours": 12,
    "AggregationIntervalSeconds": 60
  },
  "Expiry": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "AutoWriteOff": true,
    "BatchSize": 500
  },
  "Stock": {
    "ShelfLife": {
      "WarningFraction": 0.5,
      "WarningHours": 24,
      "CriticalFraction": 0.2,
      "CriticalHours": 6
    }
  },
  "Auth": {
    "SigningKey": "",
    "Issuer": "mise",
    "Audience": "mise",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 5,
    "CookieSecure": true,
    "DemoUsersPassword": "",
    "SimulatorPassword": ""
  },
  "RateLimiting": {
    "LoginPerMinute": 10,
    "GlobalPerMinute": 600
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false
  },
  "Security": {
    "Hsts": true
  }
}
