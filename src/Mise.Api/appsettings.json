{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Seed": {
    "Enabled": false
  },
  "Realtime": {
    "DebounceMilliseconds": 250
  },
  "Demo": {
    "Enabled": false
  },
  "HotOffers": {
    "Scorer": "v2",
    "RefreshSeconds": 60,
    "HistoryDays": 7,
    "MaxHorizonHours": 72,
    "HorizonShelfFraction": 0.5,
    "VolumeBaseWeight": 0.5,
    "ShareBaseWeight": 0.6,
    "SecondaryBonus": 0.25,
    "SellThroughFloor": 0.5,
    "FullCapacityPortions": 3,
    "EnterThreshold": 15,
    "ExitThreshold": 10,
    "TopN": 5
  },
  "Expiry": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "AutoWriteOff": true,
    "BatchSize": 500
  },
  "Stock": {
    "ShelfLife": {
      "WarningFraction": 0.5,
      "WarningHours": 24,
      "CriticalFraction": 0.2,
      "CriticalHours": 6
    }
  }
}
