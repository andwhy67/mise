{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=mise;Username=mise;Password=mise_dev_password",
    "Redis": "localhost:6380"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost:8081"
  },
  "Database": {
    "MigrateOnStartup": true,
    "ReadOnlyUser": "mise_readonly",
    "ReadOnlyPassword": "mise_readonly_dev"
  },
  "Swagger": {
    "Enabled": true
  },
  "Seed": {
    "Enabled": true
  },
  "Demo": {
    "Enabled": true
  },
  "Auth": {
    "SigningKey": "dev-only-signing-key-not-for-production-0123456789",
    "DemoUsersPassword": "mise-demo",
    "SimulatorPassword": "mise-simulator",
    "CookieSecure": false
  }
}
